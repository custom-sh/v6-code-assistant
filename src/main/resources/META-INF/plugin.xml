<idea-plugin>
    <id>com.ims.code.helper</id>
    <name>V6 Code Assistant</name>
    <vendor email="shenwl@ims.com" url="https://ims.com">shenwl</vendor>

    <description><![CDATA[
    <b>V6 Code Assistant</b> - 基于V6项目规范的代码助手工具<br/>
    <br/>
    功能特性：<br/>
    - 基于模板的代码生成（Column、Table、Model、Vue、Vo、Menu等）<br/>
    - 可视化配置面板，一键初始化项目模板、一键升级版本、构建项目<br/>
    - 支持多端项目配置（服务端、Web端、PDA端）<br/>
    - 支持多语言<br/>
    - AI 接口预留（后期扩展）
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 统一配置面板 -->
        <projectConfigurable
                id="ims.project.settings"
                displayName="V6 Code Assistant"
                instance="com.ims.code.helper.config.ImsProjectConfigurable"/>
        <!-- 服务注册 -->
        <projectService serviceImplementation="com.ims.code.helper.config.ImsProjectSettings"/>
        <applicationService serviceImplementation="com.ims.code.helper.config.ImsGlobalSettings"/>
        <!-- 通知组 -->
        <notificationGroup id="V6 Code Assistant" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="ImsCodeHelper.Group" text="V6 Code Assistant" description="V6 Code Assistant Actions" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <action id="ImsCodeHelper.GenerateCode"
                    class="com.ims.code.helper.action.GenerateCodeAction"
                    text="Generate Code">
                <override-text place="MainMenu" use-attribute-of-id="text"/>
            </action>
            <action id="ImsCodeHelper.OpenSettings"
                    class="com.ims.code.helper.action.OpenSettingsAction"
                    text="Open V6 Settings">
                <override-text place="MainMenu" use-attribute-of-id="text"/>
            </action>
        </group>
    </actions>
</idea-plugin>
